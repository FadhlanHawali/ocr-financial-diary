# One settings file for the whole stack: copy to .env (git-ignored) and fill in.
# docker-compose.yaml passes each value to the service that needs it.
# Keep comments on their own lines: after an empty value, "# ..." would become the value.

# --- Telegram bot (REQUIRED) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Sure → Settings → API key (create it after Sure's first start)
SURE_API_KEY=
# Strongly recommended: only these chats may use the bot (comma-separated).
# Send the bot a message once to get your chat ID; if your chat isn't listed it replies with your chat ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Telegram bot (optional) ---
# SURE_API_URL=http://sure-web:3000/api/v1
# Receipts OCR'd at the same time (OCR is CPU heavy)
# MAX_CONCURRENT_OCR=1
# info or debug
# BOT_LOG_LEVEL=info

# --- OCR server (optional) ---
# The Docker image has the CPU build of PaddlePaddle
# OCR_DEVICE=cpu
# OCR_LANG=id
# Template used when no bank is recognised; set it empty (OCR_DEFAULT_BANK=) for "Unknown"
# OCR_DEFAULT_BANK=BCA
# true only for photos of paper receipts (it crops app screenshots)
# OCR_DOC_UNWARPING=false
# INFO or DEBUG
# OCR_LOG_LEVEL=INFO

# --- Sure ---
POSTGRES_USER=sure_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sure_production
# openssl rand -hex 64; set it once and never change it afterwards
SECRET_KEY_BASE=change_this_to_a_long_random_string
# Optional, enables Sure's AI features (costs money)
# OPENAI_ACCESS_TOKEN=
# Sure's port on the host
# PORT=3000

# --- Optional: Cloudflare tunnel (--profile tunnel) , to Expose your Sure Web to the Internet---
# CLOUDFLARE_TOKEN=
